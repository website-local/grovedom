{
  "name": "grovedom",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "description": "Wasm-first Cheerio-shaped HTML/XML DOM with ordered operations",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./src/browser.d.ts",
        "default": "./src/browser.js"
      },
      "node": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "import": "./src/browser.js"
    }
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:fuzz": "node test/fuzz.mjs",
    "test:types": "node scripts/check-types.mjs",
    "bench": "node bench/run.mjs",
    "package:targets": "node scripts/package-targets.mjs",
    "ci:pack": "node scripts/ci/pack.mjs",
    "ci:install": "node scripts/ci/install.mjs",
    "ci:test": "node scripts/ci/test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "cheerio": "1.2.0",
    "typescript": "6.0.3"
  },
  "browser": "./src/browser.js",
  "files": [
    "src",
    "grovedom.wasm",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/website-local/grovedom.git"
  },
  "homepage": "https://github.com/website-local/grovedom#readme",
  "bugs": {
    "url": "https://github.com/website-local/grovedom/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
