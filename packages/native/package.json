{
  "name": "grovedom-native",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "description": "Experimental Linux Node-API target for GroveDOM",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "linux"
  ],
  "exports": {
    ".": {
      "types": "./src/native.d.ts",
      "import": "./src/native.js"
    }
  },
  "files": [
    "src",
    "grovedom.node",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/website-local/grovedom.git"
  },
  "homepage": "https://github.com/website-local/grovedom#readme",
  "bugs": {
    "url": "https://github.com/website-local/grovedom/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ]
}
